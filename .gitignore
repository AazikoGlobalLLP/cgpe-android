# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase FCM V1 service account key — SECRET (grants push/admin on the Firebase
# project). NEVER commit — it goes ONLY to EAS credentials, never into the app/build.
*-firebase-adminsdk-*.json
google-service-account*.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# agent tooling installed into the working copy, not project source
.agents/

# Phase 18 E2E harness — commit the specs/config, ignore the run output
e2e/artifacts/
test-results/
playwright-report/
.playwright/

# EAS keystore export — SECRET. `eas credentials` → "Download credentials from EAS
# to credentials.json" writes the .jks AND its keystore/key passwords in PLAINTEXT
# here. The .jks is already ignored above; this file must never be committed either.
credentials.json
credentials/

# Voice probe captures (raw responses; may contain live reply text)
e2e/voice-probe/

# Staff data dump — SECRET. `cgpe-connect.staff_unified.json` carries staff password_hash (bcrypt)
# values plus emails/phones; a bcrypt hash is crackable offline, so this must never enter git
# history. Owner decision 2026-09-03: gitignore it (do not commit, even redacted, without a fresh call).
cgpe-connect.staff_unified.json
*.staff_unified.json
