{
  "expo": {
    "name": "CGPE Connect",
    "slug": "ANDROID",
    "version": "1.10.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/6d177f14-d6e3-494a-8ae3-d764332ff256",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/android-icon-cgpe.png",
    "scheme": "cgpe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ios-icon.png",
      "bundleIdentifier": "com.cgpe.connect",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-cgpe-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.cgpe.connect",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-task-manager",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/cgpe-logo.png",
          "imageWidth": 190
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CGPE Connect records your field route while you are clocked in, so your shift and travel are logged accurately.",
          "locationWhenInUsePermission": "CGPE Connect uses your location to confirm you are at the office when you clock in, and to record your field route while you are on duty.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CGPE Connect needs access to your photos and videos to attach claim documents and evidence.",
          "cameraPermission": "CGPE Connect needs camera access to capture claim and KYC documents, and to record claim evidence.",
          "microphonePermission": "CGPE Connect needs the microphone to record sound with claim evidence videos."
        }
      ],
      "react-native-compressor",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CGPE Connect uses Face ID to securely unlock the app."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enablePngCrunchInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#155DFB",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "CGPE Connect adds your assigned tasks and reminders to your calendar so your deadlines show alongside your other events."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "CGPE Connect uses the microphone only while you hold the voice button, to record your spoken request for the assistant."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d177f14-d6e3-494a-8ae3-d764332ff256"
      }
    }
  }
}
