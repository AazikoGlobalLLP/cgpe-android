{
  "expo": {
    "name": "CGPE Connect",
    "slug": "ANDROID",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/cgpe-logo.png",
    "scheme": "cgpe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.cgpe.connect",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/cgpe-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shivambhadoriya.ANDROID"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/cgpe-logo.png",
          "imageWidth": 190
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CGPE Connect uses your location to record field attendance when you clock in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CGPE Connect needs access to your photos to attach claim documents.",
          "cameraPermission": "CGPE Connect needs camera access to capture claim and KYC documents."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CGPE Connect uses Face ID to securely unlock the app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d177f14-d6e3-494a-8ae3-d764332ff256"
      }
    }
  }
}
